OPENROUTER_API_KEY=
# 省略時は OpenRouter 本体。互換のプロキシ等を挟むときだけ指定する
OPENROUTER_BASE_URL=
# エージェントのプロバイダに Gemini を選ぶときだけ必要（Google AI Studio の API キー）
GOOGLE_GENERATIVE_AI_API_KEY=
# Web検索ノードを使うときだけ必要
TAVILY_API_KEY=
# 判定ノード（Jev）を使うときだけ必要
TYPESAFE_API_KEY=
PORT=8787
# 省略時はサーバー作業ディレクトリ直下の data/playground.db
DATABASE_PATH=
